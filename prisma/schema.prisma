// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                  @id @default(uuid())
  email                     String                  @unique
  passwordHash              String
  fullName                  String
  isMfaEnabled              Boolean                 @default(false)
  mfaSecretEncrypted        String?
  isSuperadmin              Boolean                 @default(false)
  status                    String                  @default("ACTIVE") // ACTIVE, SUSPENDED, INVITED
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  version                   Int                     @default(1)
  sessions                  UserSession[]
  memberships               TenantMembership[]
  reconciledTransactions    ReconciledTransaction[] @relation("ReconciledTransactions")
  resolvedProposals         Proposal[]              @relation("ResolvedProposals")
  bankingResolvedExceptions BankingExceptionItem[]  @relation("BankingResolvedExceptions")
  approvedPayrollRuns       PayrollRun[]            @relation("ApprovedPayrollRuns")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Tenant {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  legalName              String
  taxIdentifier          String?
  baseCurrency           String                  @default("USD")
  timezone               String                  @default("UTC")
  status                 String                  @default("ACTIVE") // ACTIVE, TRIAL, DELINQUENT, SUSPENDED
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  version                Int                     @default(1)
  memberships            TenantMembership[]
  settings               TenantSettings?
  counterparties         Counterparty[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  payments               Payment[]
  paymentAllocations     PaymentAllocation[]
  transactions           Transaction[]
  exceptions             Exception[]
  fiscalYears            FiscalYear[]
  accountingPeriods      AccountingPeriod[]
  chartOfAccounts        ChartOfAccount[]
  journalEntries         JournalEntry[]
  journalEntryLines      JournalEntryLine[]
  accountMonthlyBalances AccountMonthlyBalance[]
  bankAccounts           BankAccount[]
  bankStatements         BankStatement[]
  bankTransactions       BankTransaction[]
  reconciledTransactions ReconciledTransaction[]
  proposals              Proposal[]
  bankingExceptions      BankingExceptionItem[]
  employees              Employee[]
  compensationConfigs    CompensationConfig[]
  payrollRuns            PayrollRun[]
  payrollItems           PayrollItem[]
  products               Product[]
  stockBatches           StockBatch[]
  stockMovements         StockMovement[]
  inventoryAlerts        InventoryAlert[]
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode  String
  status    String   @default("ACTIVE") // ACTIVE, INVITED, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
}

model TenantSettings {
  tenantId                 String   @id
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  autoPostMinConfidence    Float    @default(0.95)
  maxAutoPostAmountCents   BigInt   @default(500000)
  allowAiAutoPosting       Boolean  @default(true)
  requireReceiptAboveCents BigInt   @default(7500)
  updatedAt                DateTime @updatedAt
  version                  Int      @default(1)
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  date        DateTime
  amount      Float
  description String
  category    String?
  vendor      String?
  status      String   @default("pending") // pending, categorized, reconciled, exception
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Exception {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        String // unrecognized_vendor, ambiguous_category, missing_receipt
  severity    String // low, medium, high
  description String
  aiProposal  String?
  status      String   @default("open") // open, resolved, ignored
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FiscalYear {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  yearLabel String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  periods AccountingPeriod[]

  @@unique([tenantId, yearLabel])
}

model AccountingPeriod {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  fiscalYearId   String
  fiscalYear     FiscalYear              @relation(fields: [fiscalYearId], references: [id])
  periodNumber   Int
  periodName     String
  startDate      DateTime
  endDate        DateTime
  status         String                  @default("OPEN") // OPEN, LOCKED, CLOSED
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime                @default(now())
  journalEntries JournalEntry[]
  balances       AccountMonthlyBalance[]
  payrollRuns    PayrollRun[]

  @@unique([tenantId, fiscalYearId, periodNumber])
}

model ChartOfAccount {
  id                       String                  @id @default(uuid())
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id])
  accountCode              String
  name                     String
  classification           String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  subClassification        String?
  parentAccountId          String?
  parentAccount            ChartOfAccount?         @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts            ChartOfAccount[]        @relation("AccountHierarchy")
  isActive                 Boolean                 @default(true)
  isSystemLocked           Boolean                 @default(false)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  version                  Int                     @default(1)
  journalEntryLines        JournalEntryLine[]
  monthlyBalances          AccountMonthlyBalance[]
  counterparties           Counterparty[]
  invoiceLines             InvoiceLine[]
  paymentAccounts          Payment[]               @relation("PaymentAccount")
  bankAccounts             BankAccount[]           @relation("BankAccountLedgerAccount")
  proposalDebitAccounts    Proposal[]              @relation("ProposalDebitAccount")
  proposalCreditAccounts   Proposal[]              @relation("ProposalCreditAccount")
  productInventoryAccounts Product[]               @relation("ProductInventoryAccount")
  productCogsAccounts      Product[]               @relation("ProductCogsAccount")
  productSalesAccounts     Product[]               @relation("ProductSalesAccount")

  @@unique([tenantId, accountCode])
}

model Counterparty {
  id               String          @id @default(uuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  type             String // VENDOR, CUSTOMER, BOTH
  legalName        String
  normalizedName   String
  taxIdentifier    String?
  defaultAccountId String?
  defaultAccount   ChartOfAccount? @relation(fields: [defaultAccountId], references: [id])
  paymentTermsDays Int             @default(30)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  version          Int             @default(1)
  invoices         Invoice[]
  payments         Payment[]
  proposals        Proposal[]

  @@unique([tenantId, normalizedName])
}

model JournalEntry {
  id                     String                  @id @default(uuid())
  tenantId               String
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id])
  accountingPeriodId     String
  accountingPeriod       AccountingPeriod        @relation(fields: [accountingPeriodId], references: [id])
  entryNumber            String
  entryDate              DateTime
  description            String
  status                 String                  @default("DRAFT") // DRAFT, POSTED, REVERSED
  sourceType             String // MANUAL, INVOICE, BILL, PAYMENT, PAYROLL, BANK_RECONCILIATION, INVENTORY
  sourceId               String?
  reversesEntryId        String?
  reversesEntry          JournalEntry?           @relation("JournalEntryReversal", fields: [reversesEntryId], references: [id])
  reversedByEntries      JournalEntry[]          @relation("JournalEntryReversal")
  totalDebitCents        BigInt                  @default(0)
  totalCreditCents       BigInt                  @default(0)
  createdByUserId        String?
  createdByAgentId       String?
  postedAt               DateTime?
  createdAt              DateTime                @default(now())
  lines                  JournalEntryLine[]
  invoices               Invoice[]
  payments               Payment[]
  reconciledTransactions ReconciledTransaction[]
  proposalPostedEntries  Proposal[]              @relation("ProposalPostedJournalEntry")
  payrollRuns            PayrollRun[]
  stockMovements         StockMovement[]

  @@unique([tenantId, entryNumber])
}

model JournalEntryLine {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  lineNumber     Int
  debitCents     BigInt         @default(0)
  creditCents    BigInt         @default(0)
  memo           String?
  createdAt      DateTime       @default(now())

  @@unique([journalEntryId, lineNumber])
}

model AccountMonthlyBalance {
  id                  String           @id @default(uuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  accountId           String
  account             ChartOfAccount   @relation(fields: [accountId], references: [id])
  accountingPeriodId  String
  accountingPeriod    AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])
  openingBalanceCents BigInt           @default(0)
  totalDebitCents     BigInt           @default(0)
  totalCreditCents    BigInt           @default(0)
  closingBalanceCents BigInt           @default(0)
  updatedAt           DateTime         @updatedAt

  @@unique([tenantId, accountId, accountingPeriodId])
}

model Invoice {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  counterpartyId   String
  counterparty     Counterparty        @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  sourceDocumentId String?
  journalEntryId   String?
  journalEntry     JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  invoiceType      String // BILL, INVOICE
  invoiceNumber    String
  issueDate        DateTime
  dueDate          DateTime
  currency         String              @default("USD")
  subtotalCents    BigInt
  taxCents         BigInt              @default(0)
  totalCents       BigInt
  amountDueCents   BigInt
  status           String              @default("DRAFT") // DRAFT, APPROVED, POSTED, PARTIALLY_PAID, PAID, VOID
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  version          Int                 @default(1)
  lines            InvoiceLine[]
  allocations      PaymentAllocation[]

  @@unique([tenantId, counterpartyId, invoiceType, invoiceNumber])
}

model InvoiceLine {
  id            String         @id @default(uuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoiceId     String
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  accountId     String
  account       ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lineNumber    Int
  description   String
  quantity      Float          @default(1)
  unitCostCents BigInt
  totalCents    BigInt
  createdAt     DateTime       @default(now())

  @@unique([invoiceId, lineNumber])
}

model Payment {
  id               String              @id @default(uuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  counterpartyId   String
  counterparty     Counterparty        @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  bankAccountId    String?
  paymentAccountId String
  paymentAccount   ChartOfAccount      @relation("PaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  journalEntryId   String?
  journalEntry     JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  paymentType      String // DISBURSEMENT, RECEIPT
  paymentDate      DateTime
  amountCents      BigInt
  paymentMethod    String // ACH, WIRE, CHECK, CREDIT_CARD, CASH
  referenceNumber  String?
  status           String              @default("CLEARED") // CLEARED, VOID
  createdAt        DateTime            @default(now())
  allocations      PaymentAllocation[]
}

model PaymentAllocation {
  id                   String   @id @default(uuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  paymentId            String
  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoiceId            String
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  allocatedAmountCents BigInt
  createdAt            DateTime @default(now())
}

model BankAccount {
  id                     String            @id @default(uuid())
  tenantId               String
  tenant                 Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ledgerAccountId        String
  ledgerAccount          ChartOfAccount    @relation("BankAccountLedgerAccount", fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  accountName            String
  institutionName        String
  accountType            String // CHECKING, SAVINGS, CREDIT_CARD
  currency               String            @default("USD")
  accountNumberLast4     String
  currentBalanceCents    BigInt            @default(0)
  reconciledBalanceCents BigInt            @default(0)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  version                Int               @default(1)
  statements             BankStatement[]
  transactions           BankTransaction[]

  @@index([tenantId, isActive])
}

model BankStatement {
  id                  String            @id @default(uuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bankAccountId       String
  bankAccount         BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  sourceDocumentId    String?
  fileName            String
  fileSha256          String
  mimeType            String
  statementStartDate  DateTime
  statementEndDate    DateTime
  openingBalanceCents BigInt
  closingBalanceCents BigInt
  totalDebitsCents    BigInt            @default(0)
  totalCreditsCents   BigInt            @default(0)
  status              String            @default("UPLOADED") // UPLOADED, PROCESSING, PARSED, RECONCILED, FAILED, EXCEPTION
  retryCount          Int               @default(0)
  errorMessage        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  version             Int               @default(1)
  transactions        BankTransaction[]

  @@unique([tenantId, fileSha256])
  @@unique([tenantId, bankAccountId, statementStartDate, statementEndDate])
  @@index([tenantId, bankAccountId, status])
}

model BankTransaction {
  id                    String                 @id @default(uuid())
  tenantId              String
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bankStatementId       String
  bankStatement         BankStatement          @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  bankAccountId         String
  bankAccount           BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  transactionDate       DateTime
  amountCents           BigInt
  rawDescription        String
  normalizedPayee       String?
  referenceNumber       String?
  transactionHash       String
  status                String                 @default("UNRECONCILED") // UNRECONCILED, PROPOSED, MATCHED, RECONCILED, EXCLUDED, FLAGGED
  createdAt             DateTime               @default(now())
  reconciledTransaction ReconciledTransaction?
  proposals             Proposal[]

  @@unique([tenantId, bankAccountId, transactionHash])
  @@index([tenantId, status, transactionDate])
  @@index([bankStatementId])
}

model ReconciledTransaction {
  id                   String          @id @default(uuid())
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bankTransactionId    String          @unique
  bankTransaction      BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  journalEntryId       String
  journalEntry         JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  reconciliationMethod String // AUTO_HIGH_CONFIDENCE, HUMAN_APPROVED, MANUAL_MATCH
  confidenceScore      Float?
  reconciledByUserId   String?
  reconciledByUser     User?           @relation("ReconciledTransactions", fields: [reconciledByUserId], references: [id], onDelete: SetNull)
  reconciledAt         DateTime        @default(now())

  @@index([tenantId, reconciledAt])
  @@index([journalEntryId])
}

model Proposal {
  id                   String          @id @default(uuid())
  tenantId             String
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bankTransactionId    String
  bankTransaction      BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  invoiceId            String?
  counterpartyId       String?
  counterparty         Counterparty?   @relation(fields: [counterpartyId], references: [id], onDelete: SetNull)
  proposalType         String // INVOICE_MATCH, VENDOR_PAYMENT, TRANSFER, REFUND, EXPENSE_CLASSIFICATION, REVENUE_CLASSIFICATION, AMBIGUOUS
  debitAccountId       String
  debitAccount         ChartOfAccount  @relation("ProposalDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId      String
  creditAccount        ChartOfAccount  @relation("ProposalCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  amountCents          BigInt
  confidenceScore      Float
  evidence             Json
  rationale            String
  status               String          @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, MODIFIED
  autoPostEligible     Boolean         @default(false)
  postedJournalEntryId String?
  postedJournalEntry   JournalEntry?   @relation("ProposalPostedJournalEntry", fields: [postedJournalEntryId], references: [id], onDelete: SetNull)
  resolvedByUserId     String?
  resolvedByUser       User?           @relation("ResolvedProposals", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  createdAt            DateTime        @default(now())

  @@index([tenantId, status])
  @@index([bankTransactionId])
}

model BankingExceptionItem {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  entityType         String // STATEMENT, BANK_TRANSACTION, PROPOSAL, INVOICE
  entityId           String
  exceptionType      String
  severity           String // LOW, MEDIUM, HIGH, CRITICAL
  reason             String
  evidence           Json?
  proposedResolution Json?
  status             String    @default("OPEN") // OPEN, RESOLVED, DISMISSED
  resolvedByUserId   String?
  resolvedByUser     User?     @relation("BankingResolvedExceptions", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([tenantId, status])
}

model Employee {
  id                 String              @id @default(uuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  firstName          String
  lastName           String
  email              String
  ssnLast4           String
  department         String              @default("General")
  jobTitle           String
  payType            String // SALARY, HOURLY
  rateCents          BigInt
  status             String              @default("ACTIVE") // ACTIVE, TERMINATED, LEAVE
  hireDate           DateTime
  terminationDate    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  version            Int                 @default(1)
  compensationConfig CompensationConfig?
  payrollItems       PayrollItem[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

model CompensationConfig {
  id                                    String   @id @default(uuid())
  tenantId                              String
  tenant                                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employeeId                            String   @unique
  employee                              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payPeriodsPerYear                     Int      @default(26) // 12, 24, 26, 52
  taxWithholdingRateBasisPoints         Int      @default(1500)
  standardDeductionCents                BigInt   @default(0)
  retirementContributionRateBasisPoints Int      @default(0)
  directDepositAccountLast4             String?
  createdAt                             DateTime @default(now())
  updatedAt                             DateTime @updatedAt
  version                               Int      @default(1)

  @@unique([tenantId, employeeId])
}

model PayrollRun {
  id                   String           @id @default(uuid())
  tenantId             String
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  accountingPeriodId   String
  accountingPeriod     AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  journalEntryId       String?
  journalEntry         JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  runNumber            String
  payPeriodStart       DateTime
  payPeriodEnd         DateTime
  paymentDate          DateTime
  totalGrossCents      BigInt           @default(0)
  totalTaxCents        BigInt           @default(0)
  totalDeductionsCents BigInt           @default(0)
  totalNetCents        BigInt           @default(0)
  status               String           @default("DRAFT") // DRAFT, AWAITING_APPROVAL, APPROVED, POSTED, CANCELLED
  approvedByUserId     String?
  approvedByUser       User?            @relation("ApprovedPayrollRuns", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  postedAt             DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  version              Int              @default(1)
  items                PayrollItem[]

  @@unique([tenantId, payPeriodStart, payPeriodEnd])
  @@index([tenantId, status])
}

model PayrollItem {
  id                   String     @id @default(uuid())
  tenantId             String
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  payrollRunId         String
  payrollRun           PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hoursWorked          Float      @default(0)
  grossPayCents        BigInt
  taxWithholdingsCents BigInt
  deductionsCents      BigInt
  netPayCents          BigInt
  breakdown            Json // { standardDeductionCents, retirementContributionCents, otherDeductionsCents }
  createdAt            DateTime   @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
}

model Product {
  id                 String           @id @default(uuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sku                String
  name               String
  description        String?
  unitOfMeasure      String           @default("UNIT") // UNIT, KG, LITER, BOX, PACK
  valuationMethod    String           @default("FIFO") // FIFO, WAV
  inventoryAccountId String
  inventoryAccount   ChartOfAccount   @relation("ProductInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  cogsAccountId      String
  cogsAccount        ChartOfAccount   @relation("ProductCogsAccount", fields: [cogsAccountId], references: [id], onDelete: Restrict)
  salesAccountId     String
  salesAccount       ChartOfAccount   @relation("ProductSalesAccount", fields: [salesAccountId], references: [id], onDelete: Restrict)
  lowStockThreshold  Float            @default(0)
  reorderQuantity    Float            @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  version            Int              @default(1)
  batches            StockBatch[]
  movements          StockMovement[]
  alerts             InventoryAlert[]

  @@unique([tenantId, sku])
  @@index([tenantId, isActive])
}

model StockBatch {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  batchReference    String
  receivedDate      DateTime
  originalQuantity  Float
  remainingQuantity Float
  unitCostCents     BigInt
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  movements         StockMovement[]

  @@index([tenantId, productId, remainingQuantity])
}

model StockMovement {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockBatchId    String?
  stockBatch      StockBatch?   @relation(fields: [stockBatchId], references: [id], onDelete: SetNull)
  journalEntryId  String?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  movementType    String // INFLOW_PURCHASE, OUTFLOW_SALE, ADJUSTMENT_WRITE_OFF, ADJUSTMENT_RECOUNT
  quantity        Float // positive for inflow, negative for outflow
  unitCostCents   BigInt
  totalCostCents  BigInt
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([tenantId, productId, createdAt])
}

model InventoryAlert {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  alertType         String // LOW_STOCK, OUT_OF_STOCK
  currentQuantity   Float
  thresholdQuantity Float
  status            String    @default("OPEN") // OPEN, RESOLVED, DISMISSED
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  @@index([tenantId, productId, status])
}
