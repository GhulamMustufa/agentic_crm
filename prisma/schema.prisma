// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  passwordHash       String
  fullName           String
  isMfaEnabled       Boolean            @default(false)
  mfaSecretEncrypted String?
  isSuperadmin       Boolean            @default(false)
  status             String             @default("ACTIVE") // ACTIVE, SUSPENDED, INVITED
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  version            Int                @default(1)
  sessions           UserSession[]
  memberships        TenantMembership[]
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Tenant {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  legalName              String
  taxIdentifier          String?
  baseCurrency           String                  @default("USD")
  timezone               String                  @default("UTC")
  status                 String                  @default("ACTIVE") // ACTIVE, TRIAL, DELINQUENT, SUSPENDED
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  version                Int                     @default(1)
  memberships            TenantMembership[]
  settings               TenantSettings?
  transactions           Transaction[]
  exceptions             Exception[]
  fiscalYears            FiscalYear[]
  accountingPeriods      AccountingPeriod[]
  chartOfAccounts        ChartOfAccount[]
  journalEntries         JournalEntry[]
  journalEntryLines      JournalEntryLine[]
  accountMonthlyBalances AccountMonthlyBalance[]
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode  String
  status    String   @default("ACTIVE") // ACTIVE, INVITED, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
}

model TenantSettings {
  tenantId                 String   @id
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  autoPostMinConfidence   Float    @default(0.95)
  maxAutoPostAmountCents   BigInt   @default(500000)
  allowAiAutoPosting       Boolean  @default(true)
  requireReceiptAboveCents BigInt   @default(7500)
  updatedAt                DateTime @updatedAt
  version                  Int      @default(1)
}

model Transaction {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  date        DateTime
  amount      Float
  description String
  category    String?
  vendor      String?
  status      String   @default("pending") // pending, categorized, reconciled, exception
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Exception {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        String   // unrecognized_vendor, ambiguous_category, missing_receipt
  severity    String   // low, medium, high
  description String
  aiProposal  String?
  status      String   @default("open") // open, resolved, ignored
  amount      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FiscalYear {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  yearLabel String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())

  periods AccountingPeriod[]

  @@unique([tenantId, yearLabel])
}

model AccountingPeriod {
  id             String                  @id @default(uuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  fiscalYearId   String
  fiscalYear     FiscalYear              @relation(fields: [fiscalYearId], references: [id])
  periodNumber   Int
  periodName     String
  startDate      DateTime
  endDate        DateTime
  status         String                  @default("OPEN") // OPEN, LOCKED, CLOSED
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime                @default(now())
  journalEntries JournalEntry[]
  balances       AccountMonthlyBalance[]

  @@unique([tenantId, fiscalYearId, periodNumber])
}

model ChartOfAccount {
  id                String                  @id @default(uuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  accountCode       String
  name              String
  classification    String                  // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  subClassification String?
  parentAccountId   String?
  parentAccount     ChartOfAccount?         @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts     ChartOfAccount[]        @relation("AccountHierarchy")
  isActive          Boolean                 @default(true)
  isSystemLocked    Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  version           Int                     @default(1)
  journalEntryLines JournalEntryLine[]
  monthlyBalances   AccountMonthlyBalance[]

  @@unique([tenantId, accountCode])
}

model JournalEntry {
  id                 String             @id @default(uuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  accountingPeriodId String
  accountingPeriod   AccountingPeriod   @relation(fields: [accountingPeriodId], references: [id])
  entryNumber        String
  entryDate          DateTime
  description        String
  status             String             @default("DRAFT") // DRAFT, POSTED, REVERSED
  sourceType         String             // MANUAL, INVOICE, BILL, PAYMENT, PAYROLL, BANK_RECONCILIATION, INVENTORY
  sourceId           String?
  reversesEntryId    String?
  reversesEntry      JournalEntry?      @relation("JournalEntryReversal", fields: [reversesEntryId], references: [id])
  reversedByEntries  JournalEntry[]     @relation("JournalEntryReversal")
  totalDebitCents    BigInt             @default(0)
  totalCreditCents   BigInt             @default(0)
  createdByUserId    String?
  createdByAgentId   String?
  postedAt           DateTime?
  createdAt          DateTime           @default(now())
  lines              JournalEntryLine[]

  @@unique([tenantId, entryNumber])
}

model JournalEntryLine {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  lineNumber     Int
  debitCents     BigInt         @default(0)
  creditCents    BigInt         @default(0)
  memo           String?
  createdAt      DateTime       @default(now())

  @@unique([journalEntryId, lineNumber])
}

model AccountMonthlyBalance {
  id                  String           @id @default(uuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id])
  accountId           String
  account             ChartOfAccount   @relation(fields: [accountId], references: [id])
  accountingPeriodId  String
  accountingPeriod    AccountingPeriod @relation(fields: [accountingPeriodId], references: [id])
  openingBalanceCents BigInt           @default(0)
  totalDebitCents     BigInt           @default(0)
  totalCreditCents    BigInt           @default(0)
  closingBalanceCents BigInt           @default(0)
  updatedAt           DateTime         @updatedAt

  @@unique([tenantId, accountId, accountingPeriodId])
}
