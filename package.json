{
  "name": "agentic-business-os",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade multi-tenant Agentic Business OS",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint \"{src,test}/**/*.ts\" --fix",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm run start:dev\" \"npm run frontend:dev\"",
    "start:all": "concurrently -n backend,frontend -c blue,magenta \"npm run start\" \"npm run frontend:dev\"",
    "start": "cross-env PORT=4000 ts-node src/main.ts",
    "start:dev": "cross-env PORT=4000 ts-node-dev --respawn --transpile-only src/main.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend run test:e2e",
    "build:all": "npm run build && npm run frontend:build",
    "validate": "npm run typecheck && npm run build:all && npm run test",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@neon/config": "^1.8.3",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.11",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.49.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^3.25.76"
  }
}
