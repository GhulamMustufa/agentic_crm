# Application & Environment Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000

# PostgreSQL 16+ Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_business_os?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# Cryptography & JWT Security
JWT_SECRET=super-secret-jwt-signing-key-minimum-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-jwt-signing-key-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# Object Storage (S3 / MinIO / Local)
STORAGE_DRIVER=local
STORAGE_BUCKET=agentic-business-os-docs
STORAGE_LOCAL_DIR=./storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=

# AI Provider Gateway
AI_DEFAULT_PROVIDER=mock
AI_TEMPERATURE=0.0
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Structured Logging & Observability
LOG_LEVEL=info
LOG_FORMAT=json
